{
  "name": "@fristy/relay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Blind, end-to-end-encrypted relay for FRISTY Remote internet access",
  "main": "src/index.ts",
  "scripts": {
    "start": "npm run build && node dist/relay.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --outfile=dist/relay.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fristy/protocol": "0.1.0",
    "@fristy/shared": "0.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0"
  }
}
