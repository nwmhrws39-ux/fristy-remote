# Generated by .github/workflows/admin-server.yml (database_id is filled in automatically).
name = "fristy-admin"
main = "src/worker.ts"
compatibility_date = "2025-10-01"

[[d1_databases]]
binding = "DB"
database_name = "fristy-admin"
database_id = "__DATABASE_ID__"

# Live updates: apps keep a WebSocket to this hub; admin changes are pushed instantly.
# (SQLite-backed Durable Objects are included in the free plan.)
[[durable_objects.bindings]]
name = "HUB"
class_name = "LiveHub"

[[migrations]]
tag = "live-hub-v1"
new_sqlite_classes = ["LiveHub"]

# Daily retention purge (see legal/DATA_RETENTION_POLICY.md)
[triggers]
crons = ["17 3 * * *"]
